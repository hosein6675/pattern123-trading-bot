# Runtime mode: demo is the safe default. Use live only on a dedicated MT5 host.
TRADING_MODE=demo
MARKET=forex
DEFAULT_SYMBOL=EURUSD
DEFAULT_TIMEFRAME=M15

# Money management
RISK_PER_TRADE_PERCENT=1.0
DAILY_DRAWDOWN_LIMIT=5.0
MAX_ACCOUNT_DRAWDOWN_PERCENT=20.0
MAX_OPEN_POSITIONS=5
MAX_TOTAL_RISK_PERCENT=3.0
MAX_CONSECUTIVE_LOSSES=3
MIN_LOT=0.01
MAX_LOT=100.0
LOT_STEP=0.01
ALLOWED_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD,BTCUSD

# Webhook / Telegram
WEBHOOK_SECRET=replace-me
BOT_TOKEN=

# Optional MT5 live broker credentials. Never commit real values.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=
MT5_DEVIATION=20
MT5_MAGIC=123123
